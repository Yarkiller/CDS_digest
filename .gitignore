.env
.env.*
!.env.example
!.env*.example
.cursor/*
.gitignore
# !.cursor/rules/
# !.cursor/rules/**
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
node_modules/
dist/
*.egg-info/

.playwright-browsers/
test-results/
.cursor/mcp.json

# --- Local tooling / agent workspace (not part of the product) ---
.claude/
.gsd/
.idea/

# `.scratch/` holds GSD scratch runs and screenshots, EXCEPT the project issue
# tracker (AGENTS.md -> docs/agents/issue-tracker.md): spec.md, map.md and issues/*.md.
/.scratch/*
!/.scratch/*/
/.scratch/*/*
!/.scratch/*/issues/
/.scratch/*/issues/*
!/.scratch/*/issues/*.md
!/.scratch/*/spec.md
!/.scratch/*/map.md

# GSD transient run artifacts (tracked planning docs are unaffected)
.planning/_*
.planning/tmp/
.planning/.tmp/
.planning/research/.cache/
.planning/ui-reviews/.gitignore
.planning/config.json
.planning/state.json
.planning/estimation-calibration.json
.planning/milestone.lock

# GSD runtime state: locks, traces and job queues are rewritten on every run
.planning/.gsd-allow-shrink
.planning/.gsd-trace.jsonl
.planning/.lock
.planning/WAITING.json
.planning/active-workstream
.planning/async-jobs/
.planning/graphs/

# Rules generated by `gsd-core install` into other agent runtimes
.clinerules/
.codex/
.gemini/
.aider*
.codebuddy/
.windsurf/

# Vercel CLI local state
.vercel/

# GSD Core local runtime (reinstallable via npx @opengsd/gsd-core@latest --cline --local)
.cline/
.gsd-staging/
gsd-core/
/agents/
scripts/changeset/
scripts/fix-slash-commands.cjs
scripts/gen-capability-registry.cjs
scripts/gen-loop-host-contract.cjs
scripts/lib/
.gsd-profile
gsd-file-manifest.json
gsd-install-state.json

# Local notebooks (demo content, not tracked)
/notebooks/

# Stray accidental files
/agent-skills-researcher.tmp.txt

# Transient local test-run logs (npm run test:web redirected output)
/pw-*.txt

# --- Generated reports, exports and local scratch (not part of the product) ---
.playwright-mcp/
playwright-report/
blob-report/
coverage/
htmlcov/
.coverage
*.pptx
~$*
/quik_start.md
*.tmp

# --- OS / editor noise ---
.DS_Store
Thumbs.db
Desktop.ini
