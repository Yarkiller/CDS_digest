# Digest CDS — local env template (names only; fill values in gitignored .env)
# Do not put secrets in this file.

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=
SUPABASE_JWT_ISSUER=
API_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5174,http://localhost:5174
ALLOWED_EMAIL_DOMAINS=@sberbank.ru,@omega.sbrf.ru
# memory (default, unit tests) | live (Supabase adapters — requires URL + SECRET_KEY)
APP_CONTAINER=memory

# Backend log level: debug | info | warning | error (structlog, JSON on stdout).
LOG_LEVEL=info

# Absolute origin for email material links (preview + send). SITE_URL wins;
# PUBLIC_SITE_URL is fallback; else http://127.0.0.1:5173 (D-11).
SITE_URL=http://127.0.0.1:5173
# PUBLIC_SITE_URL=

# Vite (publishable only — never put SUPABASE_SECRET_KEY behind VITE_)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_USE_MOCKS=true

# Digest mailer: stub (по умолчанию) | smtp | haskimail
# ADR-0005: предпочтительный живой транспорт — HTTP API Haskimail; smtp остаётся альтернативой.
MAILER=haskimail

# --- Haskimail HTTP API (ADR-0005) ---
HASKIMAIL_API_KEY=<server-token>
# Базовый адрес: SDK сам добавляет /email. Только https.
HASKIMAIL_API_URL=https://api.haskimail.ru
# Домен отправителя должен быть верифицирован в кабинете Haskimail.
HASKIMAIL_FROM=<digest-from@verified-domain>
HASKIMAIL_FROM_NAME=Digest CDS
# Пусто = transactional-стрим по умолчанию.
HASKIMAIL_MESSAGE_STREAM=

# --- SMTP relay (альтернатива, MAILER=smtp) ---
SMTP_HOST=<corporate-relay-host>
SMTP_PORT=587
SMTP_USER=<relay-user>
SMTP_PASS=<relay-pass>
SMTP_FROM=<digest-from@corporate-domain>
SMTP_FROM_NAME=Digest CDS
SMTP_TLS_MODE=starttls

# Yandex.Metrika counter id (leave empty to disable analytics).
VITE_YM_COUNTER_ID=

# Show the "Sign in with Yandex ID" OAuth button on the login page.
VITE_ENABLE_YANDEX_OAUTH=false
# Enforce the login form even when mocks are enabled (set true on the deployed app).
VITE_REQUIRE_LOGIN=false
# Supabase provider identifier for Yandex (Yandex is not a built-in provider).
VITE_YANDEX_OAUTH_PROVIDER=custom:yandex
# Domain allow-list for the SPA. Empty = strict corporate default
# (@sberbank.ru,@omega.sbrf.ru). For a demo/test of a successful Yandex login,
# add its email domain here and in backend ALLOWED_EMAIL_DOMAINS, e.g.:
# VITE_ALLOWED_EMAIL_DOMAINS=@sberbank.ru,@omega.sbrf.ru,@yandex.ru
VITE_ALLOWED_EMAIL_DOMAINS=

# Production origins for CORS/SITE_URL live in the hosting dashboards
# (Vercel env + Railway env), not here. Example:
# API_CORS_ORIGINS=https://digest-cds.vercel.app
# SITE_URL=https://digest-cds.vercel.app

